#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ===================== LAYER 0 — BASE =====================
        BASE {
            bindings = <
&kp ESC        &kp N1  &kp N2  &kp N3          &kp N4        &kp N5          &kp N6      &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB        &kp Q   &kp W   &kp E           &kp R         &kp T           &kp Y       &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp LSHFT      &kp A   &kp S   &kp D           &kp F         &kp G           &kp H       &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL      &kp Z   &kp X   &kp C           &kp V         &kp B           &kp N       &kp M   &kp COMMA  &kp DOT  &kp FSLH  &mo 4
                                &mo 3           &mkp LCLK     &mkp RCLK       &kp RET     &kp SPACE
                                                &kp LGUI      &mo 2           &kp RALT
            >;
        };

        // ===================== LAYER 1 — FN / NAV =====================
        FN {
            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6    &kp F7    &kp F8    &kp F9    &kp F10    &kp DEL
&kp CAPS   &none   &none   &none   &none   &none           &none     &none     &kp F11   &kp F12   &kp MINUS  &kp EQUAL
&kp LSHFT  &none   &none   &none   &none   &none           &none     &kp UP    &none     &none     &none      &none
&kp LCTRL  &kp LALT  &none   &none   &none   &none           &kp LEFT  &kp DOWN  &kp RIGHT &none     &kp LBKT   &kp RBKT
                        &mo 3   &none   &none           &none     &none
                                &none   &none           &none
            >;
        };

        // ===================== LAYER 2 — NUMPAD / BT =====================
        NUMPAD {
            bindings = <
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none   &none           &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS   &none  &bt BT_CLR
&none   &none         &none         &none         &none   &none           &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS    &none  &none
&none   &none         &none         &none         &none   &none           &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER   &none  &none
&none   &none         &none         &none         &none   &none           &kp KP_N0  &kp KP_N0  &kp KP_DOT &kp KP_ENTER   &none  &none
                                    &none         &none   &none           &none      &none
                                                  &none   &mo 2           &none
            >;
        };

        // ===================== LAYER 3 — SCROLL (LT0 누르는 동안 트랙볼 스크롤 + FN키) =====================
        SCROLL {
            bindings = <
&kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5          &kp F6    &kp F7    &kp F8    &kp F9    &kp F10    &kp DEL
&kp CAPS   &none   &none   &none   &none   &none           &none     &none     &kp F11   &kp F12   &kp MINUS  &kp EQUAL
&kp LSHFT  &none   &none   &none   &none   &none           &none     &kp UP    &none     &none     &none      &none
&kp LCTRL  &none   &none   &none   &none   &none           &kp LEFT  &kp DOWN  &kp RIGHT &none     &kp LBKT   &kp RBKT
                        &mo 3   &none   &none           &none     &none
                                &none   &none           &none
            >;
        };

        // ===================== LAYER 4 — SNIPE (R30 누르는 동안 스나이핑) =====================
        SNIPE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &mo 4
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
